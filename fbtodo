#!/usr/bin/env python3
"""fbtodo — the launcher.

The program is the package in `src/fbtodo/`; this file exists so that every way it is
invoked keeps working with no install and no virtualenv:

    ./fbtodo                     (from the checkout, exec bit set)
    python3 fbtodo               (or any path to this file)
    ~/Scripts/fbtodo             (a PATH symlink, resolved below)
    `fbtodo daemon …` / `fbtodo pane …`   (the pane and watch command lines, which name
                                           this path and parse it back out of `ps`)

It is deliberately thin: everything it can do is in the package, and its only job is to
put `src/` on the import path next to *this* file — through a symlink too, which is why
the realpath is what gets the directory.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "src"))

from fbtodo import main  # noqa: E402  (after the path above, deliberately)

if __name__ == "__main__":
    sys.exit(main())
