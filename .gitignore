# Runtime state — the tree should stay source-only.
__pycache__/
*.pyc
*.pyo

# Packaging artifacts, if a build is run in the checkout
build/
dist/
*.egg-info/

# fbtodo's scratch dir, if FBTODO_HOME is pointed inside the repo
.freebuff/
fbtodo-*.json
fbtodo-*.pid
fbtodo-*.log

# The notifier kit's state and config, if the kit is run from the checkout
scripts/notify/phone.conf
scripts/notify/*.state
scripts/notify/*.state.lock
scripts/notify/*.log

# Editor / OS noise
.DS_Store
*.swp
